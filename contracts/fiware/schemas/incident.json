{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://smart-factory.example.com/schemas/incident.json",
  "title": "Incident",
  "description": "NGSI-LD Incident entity schema for Smart Factory",
  "type": "object",
  "required": ["id", "type", "name", "incidentType", "severity", "description", "status", "occurredAt", "createdAt"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^urn:ngsi-ld:Incident:.*$",
      "description": "Full NGSI-LD entity ID"
    },
    "type": {
      "const": "Incident"
    },
    "name": {
      "type": "object",
      "properties": {
        "type": { "const": "Text" },
        "value": { "type": "string" }
      },
      "required": ["type", "value"]
    },
    "incidentType": {
      "type": "object",
      "properties": {
        "type": { "const": "Text" },
        "value": {
          "type": "string",
          "enum": ["safety", "equipment_failure", "quality", "production_delay", "security"]
        }
      },
      "required": ["type", "value"]
    },
    "severity": {
      "type": "object",
      "properties": {
        "type": { "const": "Text" },
        "value": {
          "type": "string",
          "enum": ["low", "medium", "high", "critical"]
        }
      },
      "required": ["type", "value"]
    },
    "description": {
      "type": "object",
      "properties": {
        "type": { "const": "Text" },
        "value": { "type": "string" }
      },
      "required": ["type", "value"]
    },
    "status": {
      "type": "object",
      "properties": {
        "type": { "const": "Text" },
        "value": {
          "type": "string",
          "enum": ["open", "investigating", "mitigated", "closed"]
        }
      },
      "required": ["type", "value"]
    },
    "timeline": {
      "type": "object",
      "properties": {
        "type": { "const": "Array" },
        "value": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "timestamp": {
                "type": "string",
                "format": "date-time"
              },
              "event": {
                "type": "string"
              },
              "source": {
                "type": "string"
              }
            },
            "required": ["timestamp", "event"]
          }
        }
      },
      "required": ["type", "value"]
    },
    "rootCause": {
      "type": "object",
      "properties": {
        "type": { "const": "Text" },
        "value": { "type": "string" }
      },
      "required": ["type", "value"]
    },
    "impactedEntities": {
      "$ref": "./base.json#/definitions/Relationship"
    },
    "reportedBy": {
      "$ref": "./base.json#/definitions/Relationship"
    },
    "assignedTo": {
      "$ref": "./base.json#/definitions/Relationship"
    },
    "resolvedAt": {
      "type": "object",
      "properties": {
        "type": { "const": "DateTime" },
        "value": { "type": "string", "format": "date-time" }
      },
      "required": ["type", "value"]
    },
    "occurredAt": {
      "type": "object",
      "properties": {
        "type": { "const": "DateTime" },
        "value": { "type": "string", "format": "date-time" }
      },
      "required": ["type", "value"]
    },
    "createdAt": {
      "type": "object",
      "properties": {
        "type": { "const": "DateTime" },
        "value": { "type": "string", "format": "date-time" }
      },
      "required": ["type", "value"]
    },
    "modifiedAt": {
      "type": "object",
      "properties": {
        "type": { "const": "DateTime" },
        "value": { "type": "string", "format": "date-time" }
      },
      "required": ["type", "value"]
    }
  }
}