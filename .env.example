# Environment — Smart Factory MQTT Broker
# Copy to .env and fill in values. Never commit .env with real credentials.

# ---------------------------------------------------------------------------
# Admin credential (broker management — not used by bridge or gateway)
# ---------------------------------------------------------------------------
MQTT_ADMIN_USERNAME=admin
MQTT_ADMIN_PASSWORD=changeme

# ---------------------------------------------------------------------------
# Bridge credentials
# ---------------------------------------------------------------------------
# CRITICAL: MQTT_BRIDGE_USERNAME MUST equal the deviceId (e.g. ukit-00000000).
# The ACL is bound to the literal username string. If the username does NOT
# match the deviceId in the topic, the broker ACL will DENY the subscription.
#
# Example: deviceId = ukit-00000000
#   MQTT_BRIDGE_USERNAME=ukit-00000000
#   ACL line: topic read smart-factory/ukit-00000000/command/down
#
# If you have multiple bridges, EACH bridge needs its own credential pair
# (username = its deviceId) and its own mosquitto/passwd entry.
# envsubst is NOT used — the username string is literal in the ACL file.
#
MQTT_BRIDGE_USERNAME=ukit-00000000
MQTT_BRIDGE_PASSWORD=changeme

# ---------------------------------------------------------------------------
# Gateway credentials
# ---------------------------------------------------------------------------
MQTT_GW_USERNAME=gateway
MQTT_GW_PASSWORD=changeme

# ---------------------------------------------------------------------------
# Broker ports
# ---------------------------------------------------------------------------
MQTT_PORT=1883
MQTT_TLS_BIND=127.0.0.1
