# Orion-LD Environment Configuration
# For production, override these in a local .env file (gitignored)

# Logging level: debug, info, warn, error
ORION_LD_LOG_LEVEL=info

# CORS: comma-separated list of allowed origins, or * for all
ORION_LD_CORS_ORIGINS=*

# MongoDB connection (these are overridden by docker-compose service definitions)
# ORION_LD_MONGO_HOST=mongodb
# ORION_LD_MONGO_DB=orion

# Advanced settings (uncomment as needed)
# ORION_LD_LOG_FORMAT=json
# ORION_LD_TRACE=10
# ORION_LD_QUERY_DIR=/opt/orion-ld/query
# ORION_LD_UPDATES_DIR=/opt/orion-ld/update
# ORION_LD_POOL_SIZE=50
# ORION_LD_MAX_LIFETIME=0
# ORION_LD_ENTITY_ID_REGEX=.*
