# MongoDB Environment Configuration
# For production, override these in a local .env file (gitignored)

# Database name for Orion-LD
MONGODB_DB=orion

# MongoDB port (internal to container)
# MONGODB_PORT=27017

# Authentication (optional - enable for production)
# MONGO_INITDB_ROOT_USERNAME=admin
# MONGO_INITDB_ROOT_PASSWORD=changeme
