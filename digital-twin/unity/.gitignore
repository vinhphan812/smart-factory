# Build automation
# *.build

# Per-repo custom ignores (Smart Factory specific)
# DO track source code
!Assets/Scripts/**/*.cs
!Assets/Scripts/**/*.shader

# DO track project settings that are not auto-generated
!ProjectSettings/ProjectSettings.asset
!ProjectSettings/TimeManager.asset
!Packages/manifest.json

# DO track test files
!Assets/Tests/**/*.cs
